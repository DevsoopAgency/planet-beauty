                  "type": "text",
                  "settings": {
                    "text": "<h4>Normal/Combination Skin</h4>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "center",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
