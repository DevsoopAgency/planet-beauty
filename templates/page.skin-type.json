        "image_Qhq6Le": {
          "type": "image",
          "name": "t:names.image",
          "settings": {
            "image": "shopify://shop_images/desktop_skin-type_img_2_1300x_65f6d339-70db-4c6a-bc93-52e0d2568236.webp",
            "link": "",
            "image_ratio": "adapt",
            "width": "custom",
