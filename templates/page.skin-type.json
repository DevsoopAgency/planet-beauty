              "blocks": {
                "text_knXpXU": {
                  "type": "text",
                  "settings": {
                    "text": "<h4>Oily Skin</h4>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "center",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
