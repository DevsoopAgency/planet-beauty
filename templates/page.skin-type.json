                "text_P4JRBX": {
                  "type": "text",
                  "settings": {
                    "text": "<h4>Dry Skin</h4>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "center",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
