{%- comment -%}
  Classic customer addresses: list / add / edit / delete.
  Country uses {{ country_option_tags }}; province is a text field so no external
  Shopify.CountryProvinceSelector dependency is needed. Delete uses a POST form
  with _method=delete (no JS dependency). Edit forms toggle with minimal vanilla JS.
{%- endcomment -%}
{% render 'pb-customer-account' %}

<div class="pb-account">
  <p><a class="pb-account__link" href="{{ routes.account_url }}">&larr; Back to my account</a></p>
  <h1 class="pb-account__title">Your addresses</h1>

  {%- paginate customer.addresses by 10 -%}
    {%- comment -%}
      ===== Add new address =====
      pb a11y: toggles use aria-expanded + aria-controls so the collapsed state
      is announced, the `hidden` attribute instead of inline display:none, and
      focus moves into the panel when it opens / back to the trigger when it
      closes (WCAG 4.1.2 Name, Role, Value + 2.4.3 Focus Order).
    {%- endcomment -%}
    <button
      type="button"
      class="button"
      data-pb-toggle="pb-address-new"
      aria-expanded="false"
      aria-controls="pb-address-new"
    >
      Add a new address
    </button>

    <div id="pb-address-new" hidden style="margin-top:24px;">
      <h2 tabindex="-1">Add a new address</h2>
      {%- form 'customer_address', customer.new_address -%}
        {% render 'pb-address-fields', address: customer.new_address, id_suffix: 'new' %}
        <div class="pb-account__field" style="flex-direction:row;align-items:center;gap:8px;">
          <input type="checkbox" id="address_default_new" name="address[default]" value="1" style="width:auto;">
          <label for="address_default_new" style="font-weight:400;">Set as default address</label>
        </div>
        <div class="pb-account__actions">
          <button type="submit" class="button">Add address</button>
          <button type="button" class="pb-account__link" data-pb-toggle="pb-address-new">Cancel</button>
        </div>
      {%- endform -%}
    </div>

    {%- comment -%} ===== Existing addresses ===== {%- endcomment -%}
    <div style="margin-top:32px;">
      {%- for address in customer.addresses -%}
        <div class="pb-account__notice" style="background:none;">
          {%- if address == customer.default_address -%}<strong>Default</strong><br>{%- endif -%}
          {{ address | format_address }}

          <div class="pb-account__actions">
            {%- comment -%}
              pb a11y (WCAG 2.4.4): "Edit" / "Delete" repeat once per address,
              so each needs the address in its accessible name. The hidden text
              is appended to the visible label — the visual design is unchanged.
            {%- endcomment -%}
            <button
              type="button"
              class="pb-account__link"
              data-pb-toggle="pb-address-edit-{{ address.id }}"
              aria-expanded="false"
              aria-controls="pb-address-edit-{{ address.id }}"
            >
              Edit<span class="visually-hidden"> address: {{ address.summary | strip_newlines | escape }}</span>
            </button>
            <form method="post" action="{{ address.url }}" onsubmit="return confirm('Delete this address?');" style="display:inline;">
              <input type="hidden" name="_method" value="delete">
              <button type="submit" class="pb-account__link">
                Delete<span class="visually-hidden"> address: {{ address.summary | strip_newlines | escape }}</span>
              </button>
            </form>
          </div>

          <div id="pb-address-edit-{{ address.id }}" hidden style="margin-top:16px;">
            <h3 tabindex="-1">Edit address</h3>
            {%- form 'customer_address', address -%}
              {% render 'pb-address-fields', address: address, id_suffix: address.id %}
              <div class="pb-account__field" style="flex-direction:row;align-items:center;gap:8px;">
                <input type="checkbox" id="address_default_{{ address.id }}" name="address[default]" value="1" {% if address == customer.default_address %}checked{% endif %} style="width:auto;">
                <label for="address_default_{{ address.id }}" style="font-weight:400;">Set as default address</label>
              </div>
              <div class="pb-account__actions">
                <button type="submit" class="button">Update address</button>
                <button type="button" class="pb-account__link" data-pb-toggle="pb-address-edit-{{ address.id }}">Cancel</button>
              </div>
            {%- endform -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      {%- comment -%} pb a11y: multiple <nav>s on a page need distinct labels (WCAG 1.3.1). {%- endcomment -%}
      <nav class="pb-account__actions" aria-label="Address pagination">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

<script>
  // pb a11y: address panel toggles.
  // Replaces inline onclick + display:none with the `hidden` attribute, keeps
  // aria-expanded on the trigger in sync, and manages focus: opening moves
  // focus into the panel heading, closing returns it to the trigger that owns
  // the panel. WCAG 2.4.3 Focus Order, 4.1.2 Name/Role/Value.
  (function () {
    function ownerTrigger(id) {
      return document.querySelector('[aria-controls="' + id + '"]');
    }

    document.querySelectorAll('[data-pb-toggle]').forEach(function (button) {
      button.addEventListener('click', function () {
        var id = button.dataset.pbToggle;
        var panel = document.getElementById(id);
        if (!panel) return;

        var willOpen = panel.hidden;
        panel.hidden = !willOpen;

        var trigger = ownerTrigger(id);
        if (trigger) trigger.setAttribute('aria-expanded', String(willOpen));

        if (willOpen) {
          var heading = panel.querySelector('h2, h3');
          if (heading) heading.focus();
        } else if (trigger) {
          trigger.focus();
        }
      });
    });
  })();
</script>
