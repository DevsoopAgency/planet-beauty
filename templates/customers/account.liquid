{%- comment -%}
  Classic customer account dashboard: order history + account details.
{%- endcomment -%}
{% render 'pb-customer-account' %}

<div class="pb-account">
  <h1 class="pb-account__title">My account</h1>
  <p class="pb-account__intro">
    <a class="pb-account__link" href="{{ routes.account_logout_url }}">Log out</a>
  </p>

  <div class="pb-account__grid pb-account__grid--2">
    <div>
      <h2>Account details</h2>
      <p>
        {{ customer.name }}<br>
        {{ customer.email }}
      </p>
      {%- if customer.default_address -%}
        <h3>Default address</h3>
        <p>{{ customer.default_address | format_address }}</p>
      {%- endif -%}
      <p>
        <a class="pb-account__link" href="{{ routes.account_addresses_url }}">View addresses ({{ customer.addresses_count }})</a>
      </p>
    </div>

    <div>
      <h2>Order history</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <table class="pb-account__table">
            <thead>
              <tr>
                <th scope="col">Order</th>
                <th scope="col">Date</th>
                <th scope="col">Payment</th>
                <th scope="col">Fulfillment</th>
                <th scope="col">Total</th>
              </tr>
            </thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td><a class="pb-account__link" href="{{ order.customer_url }}">{{ order.name }}</a></td>
                  <td>{{ order.created_at | date: "%b %d, %Y" }}</td>
                  <td>{{ order.financial_status_label }}</td>
                  <td>{{ order.fulfillment_status_label }}</td>
                  <td>{{ order.total_net_amount | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>

          {%- if paginate.pages > 1 -%}
            <nav class="pb-account__actions" role="navigation">{{ paginate | default_pagination }}</nav>
          {%- endif -%}
        {%- else -%}
          <p>You haven't placed any orders yet.</p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</div>
