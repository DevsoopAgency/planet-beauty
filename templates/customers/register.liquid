{%- comment -%}
  Classic customer registration (parity with live store classic accounts).
{%- endcomment -%}
{% render 'pb-customer-account' %}

<div class="pb-account pb-account--narrow">
  <h1 class="pb-account__title">Create account</h1>

  {%- form 'create_customer', novalidate: 'novalidate' -%}
    {%- if form.errors -%}
      <div class="pb-account__errors" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}

    <div class="pb-account__field">
      <label for="RegisterFirstName">First name</label>
      <input type="text" name="customer[first_name]" id="RegisterFirstName" autocomplete="given-name" value="{% if form.first_name %}{{ form.first_name }}{% endif %}">
    </div>

    <div class="pb-account__field">
      <label for="RegisterLastName">Last name</label>
      <input type="text" name="customer[last_name]" id="RegisterLastName" autocomplete="family-name" value="{% if form.last_name %}{{ form.last_name }}{% endif %}">
    </div>

    <div class="pb-account__field">
      <label for="RegisterEmail">Email</label>
      <input type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" autocorrect="off" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% endif %}" required>
    </div>

    <div class="pb-account__field">
      <label for="RegisterPassword">Password</label>
      <input type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" required>
    </div>

    <div class="pb-account__actions">
      <button type="submit" class="button">Create account</button>
      <a class="pb-account__link" href="{{ routes.account_login_url }}">Back to login</a>
    </div>
  {%- endform -%}
</div>
