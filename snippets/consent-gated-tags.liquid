{% comment %}
  Marketing / analytics tags must not load until OneTrust consent is granted.
  2026-10-06: Taboola loader removed at the client's request (pixel 1820245). To restore,
  see git history of this file. The "Taboola" custom pixel in Shopify Admin > Settings >
  Customer events must be disconnected separately.
  C0002 = Performance (analytics), C0004 = Targeting (marketing) — verify IDs in OneTrust admin.
  NOTE: Rebuy is NOT gated here — per client request its app embed loads
  unconditionally (re-enabled in settings_data.json) so homepage/PDP
  recommendation carousels are always present. (Reverted 2026-07-10.)
{% endcomment %}
<script type="text/javascript">
  (function () {
    var GTM_ID = 'GTM-542GFXP';
    var loaded = { gtm: false };

    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    window.gtag = window.gtag || gtag;

    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'denied',
      personalization_storage: 'denied',
      security_storage: 'granted',
      wait_for_update: 500,
    });

    /* pb-consent-early-read (2026-10-06):
       On every page load there is a short gap before OneTrust has loaded. The theme
       used to read "no groups" in that gap and tell Shopify + Google "denied", even
       for visitors who had already accepted; it was corrected ~0.5s later, but hits
       sent in between went out as consent-denied. Until OneTrust is ready we now
       read the visitor's stored choice from OneTrust's own cookies instead. */
    function readCookie(name) {
      var m = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
      if (!m) return '';
      try {
        return decodeURIComponent(m[1]);
      } catch (e) {
        return m[1];
      }
    }

    window.planetBeautyActiveGroups = function () {
      var live = window.OnetrustActiveGroups || window.OptanonActiveGroups;
      if (live) return live;
      var stored = readCookie('OptanonConsent').match(/(?:^|&)groups=([^&]*)/);
      if (!stored) return '';
      var active = [];
      stored[1].split(',').forEach(function (pair) {
        var parts = pair.split(':');
        if (parts[1] === '1') active.push(parts[0]);
      });
      return ',' + active.join(',') + ',';
    };

    /* True once the visitor has clicked a banner button (not just seen the banner). */
    window.planetBeautyStoredChoice = function () {
      return document.cookie.indexOf('OptanonAlertBoxClosed=') > -1;
    };

    /* pb-region-consent (2026-10-07): consent now follows OneTrust's ACTIVE GROUPS for the
       visitor's region, not "has the visitor clicked a button":
         - US rules (opt-out): groups are active by default -> tags load on arrival and
           stop only if the visitor opts out (preferences / Global Privacy Control).
         - EU rule (opt-in): groups are inactive until Accept -> nothing loads before.
       Groups are "known" once OneTrust has loaded, or earlier from its cookie when the
       visitor already made a choice. Until then we do nothing (no grant, no deny). */
    window.planetBeautyGroupsKnown = function () {
      if (window.OnetrustActiveGroups || window.OptanonActiveGroups) return true;
      return window.planetBeautyStoredChoice() && /(?:^|&)groups=/.test(readCookie('OptanonConsent'));
    };

    function hasGroup(id) {
      return window.planetBeautyActiveGroups().indexOf(id) > -1;
    }

    function updateConsentMode() {
      gtag('consent', 'update', {
        analytics_storage: hasGroup('C0002') ? 'granted' : 'denied',
        ad_storage: hasGroup('C0004') ? 'granted' : 'denied',
        ad_user_data: hasGroup('C0004') ? 'granted' : 'denied',
        ad_personalization: hasGroup('C0004') ? 'granted' : 'denied',
        personalization_storage: hasGroup('C0004') ? 'granted' : 'denied',
      });
    }

    function loadGTM() {
      if (loaded.gtm) return;
      loaded.gtm = true;
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0];
        var j = d.createElement(s);
        var dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', GTM_ID);
    }

    /* pb-consent-marketing-apps (migration-added, 2026-09-29, updated 2026-10-02):
       Klaviyo onsite was firing before consent. Its theme app embed is DISABLED
       in config/settings_data.json and it loads here only after a Marketing
       (C0004) choice. Klaviyo also injects a legacy ScriptTag through
       content_for_header (asyncLoad); the insert guard below holds it back.
       Attentive is intentionally NOT gated (client decision 2026-10-02: its
       signup popup carries its own disclosure). Its app embed stays ENABLED;
       the guard only drops Attentive's duplicate legacy ScriptTag when the
       embed copy is already on the page.
       To undo: remove this block + re-enable the Klaviyo embed. */
    var MARKETING_APP_SCRIPTS = [
      {
        match: /static\.klaviyo\.com\/onsite\/js\/(TTJxvR\/)?klaviyo\.js/,
        src: 'https://static.klaviyo.com/onsite/js/TTJxvR/klaviyo.js?company_id=TTJxvR',
      },
    ];
    var marketingAppsLoaded = false;

    var ATTENTIVE_TAG = /cdn\.attn\.tv\/planetbeauty\/dtag\.js/;

    function isDuplicateAttentiveTag(node) {
      return ATTENTIVE_TAG.test(node.src) && !!document.querySelector('script[src*="cdn.attn.tv/planetbeauty/dtag.js"]');
    }

    /* pb-block-taboola (2026-10-06, client request "Taboola should be removed"):
       Taboola is also loaded by a tag inside GTM (GTM-542GFXP), which we cannot edit.
       This drops every Taboola script before it is inserted, even after Accept.
       Remove this once the Taboola tag is deleted from GTM. */
    var ALWAYS_BLOCKED_SCRIPT = /(^|\/\/|\.)taboola(syndication)?\.com\//;

    function isHeldMarketingScript(node) {
      if (!node || node.nodeName !== 'SCRIPT' || !node.src) return false;
      if (ALWAYS_BLOCKED_SCRIPT.test(node.src)) return true;
      if (isDuplicateAttentiveTag(node)) return true;
      if (marketingAppsLoaded) return false;
      for (var i = 0; i < MARKETING_APP_SCRIPTS.length; i++) {
        if (MARKETING_APP_SCRIPTS[i].match.test(node.src)) return true;
      }
      return false;
    }

    ['appendChild', 'insertBefore'].forEach(function (method) {
      var original = Node.prototype[method];
      Node.prototype[method] = function (node) {
        if (isHeldMarketingScript(node)) return node;
        return original.apply(this, arguments);
      };
    });

    /* Klaviyo queue stub (same as the app embed) so klaviyo.push calls are kept until load. */
    window._klOnsite = window._klOnsite || [];
    window.klaviyo = window.klaviyo || [];
    if (typeof window.klaviyo.push !== 'function') {
      window.klaviyo.push = function () {
        window._klOnsite.push.apply(window._klOnsite, arguments);
      };
    }

    function loadMarketingApps() {
      if (marketingAppsLoaded || !hasGroup('C0004')) return;
      marketingAppsLoaded = true;
      MARKETING_APP_SCRIPTS.forEach(function (entry) {
        var s = document.createElement('script');
        s.async = true;
        s.src = entry.src;
        document.head.appendChild(s);
      });
    }

    window.planetBeautyLoadConsentTags = function () {
      if (!window.planetBeautyGroupsKnown()) return;

      updateConsentMode();
      if (hasGroup('C0002') || hasGroup('C0004')) {
        loadGTM();
      }
      loadMarketingApps();
    };
  })();
</script>
