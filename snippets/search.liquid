{%- doc -%}
  Renders the search action button.

  @param {string} [style] - The style of the search action.
  @param {string} [class] - Additional classes for the search action.
  @param {string} [display_style] - The display style ('icon' or 'text').

  @example
  {% render 'search', style: 'default', class: 'custom-class', display_style: 'icon' %}
{%- enddoc -%}

{% unless style == 'none' %}
  <search-button
    class="search-action{% if class != blank %} {{ class | strip }}{% endif %}"
  >
    <button
      on:click="#search-modal/showDialog"
      class="button-unstyled search-action__trigger"
      aria-label="{{ 'content.search_input_label' | t }}"
      aria-haspopup="dialog"
      type="button"
    >
      <span class="search-action__field">
        <span class="search-action__field-text">What can we help you find?</span>
        <span class="search-action__field-line" aria-hidden="true"></span>
      </span>
    </button>
  </search-button>
{% endunless %}

{% stylesheet %}
  .search-action {
    display: flex;
  }

  .search-action__trigger {
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
    color: inherit;
    text-align: start;
  }

  .search-action__field {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    min-width: 160px;
    border-bottom: 1px solid var(--color-border);
  }

  .search-action__field-text {
    font-family: var(--font-body--family);
    font-size: 12px;
    font-weight: 400;
    line-height: normal;
    color: rgb(var(--color-foreground-rgb) / 0.7);
    white-space: nowrap;
  }

  .search-action__field-line {
    display: block;
    width: 100%;
    border-bottom: 1px solid var(--color-border);
  }

  @media screen and (max-width: 749px) {
    .search-action--hidden-on-drawer {
      display: none;
    }

    .search-action:not(.menu-drawer__search-action) {
      display: none;
    }

    .menu-drawer__search-action {
      display: flex;
      width: 100%;
    }

    .menu-drawer__search-action .search-action__field {
      width: 100%;
      min-width: 0;
    }
  }

  @media screen and (min-width: 750px) {
    [data-menu-style='drawer'] .search-action--hidden-on-drawer {
      display: none;
    }

    [data-menu-style='menu'] .search-action--hidden-on-menu {
      display: none;
    }

    [data-menu-style='menu'] .header__column--right .search-action {
      margin-inline: 0;
    }
  }
{% endstylesheet %}
