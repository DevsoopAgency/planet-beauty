{% comment %}
  Syncs OneTrust cookie groups to Shopify Customer Privacy API so app/custom pixels
  (TikTok, Meta, Klaviyo, etc. in content_for_header) respect consent.
  Events must NOT fire until the user accepts or rejects the banner (first visit).
{% endcomment %}
<script type="text/javascript">
  (function () {
    var GROUP_ANALYTICS = 'C0002';
    var GROUP_PREFERENCES = 'C0003';
    var GROUP_MARKETING = 'C0004';

    window.planetBeautyMarketingAllowed = function () {
      var groups = window.OnetrustActiveGroups || window.OptanonActiveGroups || '';
      return groups.indexOf(GROUP_MARKETING) > -1;
    };

    window.planetBeautyHasConsentChoice = function () {
      if (window.OneTrust && typeof window.OneTrust.IsAlertBoxClosed === 'function') {
        return window.OneTrust.IsAlertBoxClosed();
      }
      return document.cookie.indexOf('OptanonConsent=') > -1;
    };

    function hasGroup(id) {
      var groups = window.OnetrustActiveGroups || window.OptanonActiveGroups || '';
      return groups.indexOf(id) > -1;
    }

    function buildTrackingConsent() {
      return {
        analytics: hasGroup(GROUP_ANALYTICS),
        marketing: hasGroup(GROUP_MARKETING),
        preferences: hasGroup(GROUP_PREFERENCES),
        sale_of_data: hasGroup(GROUP_MARKETING),
      };
    }

    function loadConsentApi(callback) {
      if (!window.Shopify || typeof window.Shopify.loadFeatures !== 'function') {
        callback(new Error('Shopify.loadFeatures unavailable'));
        return;
      }
      window.Shopify.loadFeatures(
        [{ name: 'consent-tracking-api', version: '0.1' }],
        function (error) {
          callback(error || null);
        }
      );
    }

    /* pb-consent-sync-queue (2026-10-05):
       Shopify keeps whichever setTrackingConsent call reaches it LAST. The old code
       fired many overlapping deny/grant calls (10ms deny poll + a deny during the
       Accept click), so a late "deny" could overwrite the visitor's "grant" and
       checkout then ran as consent-denied (Google Ads/GA4 purchases not recorded).
       Now: one call at a time, no-op calls skipped, and the queue always ends on
       the state OneTrust reports at that moment.
       Relies on Shopify Admin > Settings > Customer privacy requiring consent in
       all regions (pixels start denied) and on OneTrust being opt-in. */
    var DENY_ALL = { analytics: false, marketing: false, preferences: false, sale_of_data: false };
    var consentInFlight = false;
    var consentPending = false;
    var consentTimer = null;
    var consentAttempts = 0;

    function desiredConsent() {
      return window.planetBeautyHasConsentChoice() ? buildTrackingConsent() : DENY_ALL;
    }

    function matchesCurrent(target) {
      var cp = window.Shopify && window.Shopify.customerPrivacy;
      if (!cp || typeof cp.currentVisitorConsent !== 'function') return false;
      var current = cp.currentVisitorConsent() || {};
      var keys = ['analytics', 'marketing', 'preferences', 'sale_of_data'];
      for (var i = 0; i < keys.length; i++) {
        if (current[keys[i]] !== (target[keys[i]] ? 'yes' : 'no')) return false;
      }
      return true;
    }

    function flushConsent() {
      if (consentInFlight) {
        consentPending = true;
        return;
      }
      consentInFlight = true;
      consentPending = false;
      loadConsentApi(function (error) {
        var cp = window.Shopify && window.Shopify.customerPrivacy;
        if (error || !cp || typeof cp.setTrackingConsent !== 'function') {
          consentInFlight = false;
          return;
        }
        var target = desiredConsent();
        if (matchesCurrent(target)) {
          consentInFlight = false;
          if (consentPending) flushConsent();
          return;
        }
        consentAttempts++;
        cp.setTrackingConsent(target, function () {
          consentInFlight = false;
          /* Re-send only if OneTrust changed meanwhile; capped so a failing API can't loop. */
          if (consentAttempts < 5 && (consentPending || !matchesCurrent(desiredConsent()))) flushConsent();
        });
      });
    }

    /* Short delay so OneTrust has finished updating (banner closed + groups) before we read it. */
    function scheduleConsentSync() {
      if (consentTimer) clearTimeout(consentTimer);
      consentTimer = setTimeout(function () {
        consentTimer = null;
        consentAttempts = 0;
        flushConsent();
      }, 50);
    }

    window.planetBeautySyncShopifyConsent = scheduleConsentSync;
    window.planetBeautyDenyShopifyConsent = scheduleConsentSync;

    window.planetBeautyApplyConsentAfterChoice = function () {
      scheduleConsentSync();

      if (
        window.planetBeautyHasConsentChoice() &&
        typeof window.planetBeautyLoadConsentTags === 'function'
      ) {
        window.planetBeautyLoadConsentTags();
      }
    };

    document.addEventListener('OneTrustGroupsUpdated', function () {
      window.planetBeautyApplyConsentAfterChoice();
    });

    function bindOneTrustConsentChanged() {
      if (window.OneTrust && typeof window.OneTrust.OnConsentChanged === 'function') {
        window.OneTrust.OnConsentChanged(function () {
          window.planetBeautyApplyConsentAfterChoice();
        });
      }
    }

    bindOneTrustConsentChanged();
    document.addEventListener('DOMContentLoaded', bindOneTrustConsentChanged);
  })();
</script>
