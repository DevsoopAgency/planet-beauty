{% doc %}
  PB MIGRATION (custom): sender / recipient fields for the virtual gift card PDP.

  Parity with the live theme's `snippets/product-form-giftcard.liquid`, which was rendered on products
  assigned the `gift-card` template suffix. These products are regular products (not native Shopify
  gift cards), so Horizon's `gift-card-recipient-form` does not apply to them. Values are saved as line
  item properties using the same keys as the live theme. Must be rendered inside the product form.

  @param {block} block - The block object, used for element IDs.
{% enddoc %}

{%- comment -%} pb-gift-card-fields: start (custom, see doc above) {%- endcomment -%}
<div
  class="pb-gift-card-fields"
  role="group"
  aria-labelledby="pb-giftcard-heading-{{ block.id }}"
>
  <div class="pb-gift-card-fields__header">
    <p
      class="pb-gift-card-fields__heading"
      id="pb-giftcard-heading-{{ block.id }}"
    >
      Gift card details
    </p>
    <p class="pb-gift-card-fields__note">* Required</p>
  </div>
  <div class="pb-gift-card-fields__row">
    <div class="pb-gift-card-fields__field">
      <label for="pb-giftcard-sender-name-{{ block.id }}">Sender name*</label>
      <input
        class="pb-gift-card-fields__input"
        id="pb-giftcard-sender-name-{{ block.id }}"
        type="text"
        name="properties[giftcard_sender_name]"
        autocomplete="name"
        maxlength="100"
        required
        aria-required="true"
      >
    </div>
    <div class="pb-gift-card-fields__field">
      <label for="pb-giftcard-sender-email-{{ block.id }}">Sender email*</label>
      <input
        class="pb-gift-card-fields__input"
        id="pb-giftcard-sender-email-{{ block.id }}"
        type="email"
        name="properties[giftcard_sender_email]"
        autocomplete="email"
        autocorrect="off"
        autocapitalize="off"
        required
        aria-required="true"
      >
    </div>
  </div>
  <div class="pb-gift-card-fields__row">
    <div class="pb-gift-card-fields__field">
      <label for="pb-giftcard-recipient-name-{{ block.id }}">Recipient name*</label>
      <input
        class="pb-gift-card-fields__input"
        id="pb-giftcard-recipient-name-{{ block.id }}"
        type="text"
        name="properties[giftcard_recipient_name]"
        autocomplete="off"
        maxlength="100"
        required
        aria-required="true"
      >
    </div>
    <div class="pb-gift-card-fields__field">
      <label for="pb-giftcard-recipient-email-{{ block.id }}">Recipient email*</label>
      <input
        class="pb-gift-card-fields__input"
        id="pb-giftcard-recipient-email-{{ block.id }}"
        type="email"
        name="properties[giftcard_recipient_email]"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        required
        aria-required="true"
      >
    </div>
  </div>
  <div class="pb-gift-card-fields__field">
    <label for="pb-giftcard-message-{{ block.id }}">Message (optional)</label>
    <textarea
      class="pb-gift-card-fields__input pb-gift-card-fields__textarea"
      id="pb-giftcard-message-{{ block.id }}"
      name="properties[giftcard_message]"
      rows="3"
    ></textarea>
  </div>
</div>
{%- comment -%} pb-gift-card-fields: end {%- endcomment -%}

{% stylesheet %}
  /* PB MIGRATION (custom): pb-gift-card-fields. Self-contained so it can be removed with the snippet. */
  .pb-gift-card-fields {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    padding-block: var(--padding-xs) var(--padding-xl);
  }

  .pb-gift-card-fields__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--gap-sm);
  }

  .pb-gift-card-fields__heading {
    margin: 0;
    font-weight: var(--font-weight-semibold, 600);
    text-transform: uppercase;
  }

  .pb-gift-card-fields__note {
    margin: 0;
    font-size: var(--font-paragraph-small--size, 0.75rem);
  }

  /* Two columns when there is room, one column in narrow containers (mobile, quick-add modal). */
  .pb-gift-card-fields__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: var(--gap-md) var(--gap-sm);
  }

  .pb-gift-card-fields__field {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
    min-width: 0;
  }

  /* 16px text stops iOS zooming on focus; full-strength text and a 3:1 border for ADA contrast. */
  .pb-gift-card-fields__input {
    width: 100%;
    padding: var(--padding-sm) var(--padding-md);
    background-color: var(--color-input-background);
    color: var(--color-foreground);
    font-family: inherit;
    font-size: 1rem;
    line-height: 1.4;
    border: var(--style-border-width-inputs, 1px) solid rgb(var(--color-foreground-rgb) / 0.45);
    border-radius: var(--style-border-radius-inputs);
    transition: border-color var(--animation-speed) ease;
  }

  .pb-gift-card-fields__input:is(:hover, :focus) {
    border-color: var(--color-foreground);
  }

  .pb-gift-card-fields__input:focus-visible {
    outline: var(--focus-outline-width) solid var(--color-foreground);
    outline-offset: var(--focus-outline-offset);
  }

  .pb-gift-card-fields__textarea {
    min-height: 5.5rem;
    resize: vertical;
  }
{% endstylesheet %}
