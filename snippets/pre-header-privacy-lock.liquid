{% comment %}
  Must run immediately before {{ content_for_header }}. Waits for Shopify's consent API,
  then hands over to the single consent sync in snippets/onetrust-shopify-privacy.liquid.
  pb-consent-sync-queue (2026-10-05): the old 10ms "deny" poll was removed. Shopify now
  starts every visit denied (Settings > Customer privacy requires consent in all regions),
  and the repeated deny calls could overwrite a visitor's Accept.
{% endcomment %}
<script type="text/javascript">
  (function () {
    var started = false;

    function initPrivacyApi() {
      if (started) return true;
      if (!window.Shopify || typeof window.Shopify.loadFeatures !== 'function') return false;

      started = true;
      window.Shopify.loadFeatures(
        [{ name: 'consent-tracking-api', version: '0.1' }],
        function (error) {
          if (error) return;
          if (typeof window.planetBeautyApplyConsentAfterChoice === 'function') {
            window.planetBeautyApplyConsentAfterChoice();
          }
        }
      );
      return true;
    }

    if (initPrivacyApi()) return;

    var attempts = 0;
    var poll = setInterval(function () {
      if (initPrivacyApi() || ++attempts >= 80) clearInterval(poll);
    }, 10);
  })();
</script>
