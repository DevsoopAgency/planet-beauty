{% comment %}
This file is auto-generated by PageFly. The content can be overridden when publish page in PageFly. Please do not update this file directly.
If you plan to remove PageFly, please see the guide in our help center first: https://help.pagefly.io/.
{% endcomment %}
<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- comment -%}
      OneTrust cookie consent — ported from live theme. OtAutoBlock must be the
      first script in <head> so categorized tags are blocked before consent.
      Order: onetrust-head → consent-gated-tags → onetrust-shopify-privacy.
    {%- endcomment -%}
    {%- render 'onetrust-head' -%}
    {%- render 'consent-gated-tags' -%}
    {%- render 'onetrust-shopify-privacy' -%}
<meta name="google-site-verification" content="ihJ5962qliSXbtHPYyMdusK4thcdMzF7-BAv4fbVL6k" />
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% # theme-check-disable RemoteAsset %}
    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {%- comment -%}
      pb: ADA / WCAG 2.1 AA remediation layer. MUST stay after 'color-schemes'
      so it comes later in document order than base.css and than the inline
      :root variables in 'theme-styles-variables' — that ordering is what makes
      its focus-indicator and contrast overrides apply. Safe to remove.
    {%- endcomment -%}
    {{ 'pb-a11y.css' | asset_url | stylesheet_tag }}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {%- comment -%} Keep Shopify pixels denied until OneTrust consent choice (ported from live) {%- endcomment -%}
    {%- render 'pre-header-privacy-lock' -%}
    <script src="https://cdn.userway.org/widget.js" data-account="YeWwct1VPp"></script>
    {{ content_for_header }}
    {% # theme-check-enable RemoteAsset %}
  {% include 'pagefly-app-header' %}</head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}{% if template.name == 'article' %} template-article{% endif %}{% if template.name == 'page' %} template-page page-{{ template.suffix }}{% endif %}"><div class="pagefly-container">
              {{ content_for_layout }}
            </div></body>
</html>
