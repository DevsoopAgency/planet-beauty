{% capture submit_button %}
  {% content_for 'block', type: 'contact-form-submit-button', id: 'submit-button' %}
{% endcapture %}

<div
  class="
    contact-form
    spacing-style size-style
    {% if block.settings.inherit_color_scheme == false %}color-{{ block.settings.color_scheme }}{% endif %}
  "
  style="
    {% render 'spacing-style', settings: block.settings %}
    {% render 'size-style', settings: block.settings %}
  "
  {{ block.shopify_attributes }}
>
  {% assign form_id = block.id | default: section.id | prepend: 'ContactForm-' %}
  {%- form 'contact', id: form_id, class: 'contact-form__form' -%}
    <input
      name="contact[id]"
      type="hidden"
      value="{{ form_id }}"
    >

    {%- comment -%}
      One flag reused below: it decides both the confirmation and whether the
      fields are rendered at all. Leaving an empty form on screen after a
      successful send is what makes people submit again.
    {%- endcomment -%}
    {%- assign posted = false -%}
    {%- if form.posted_successfully? -%}
      {%- assign posted = true -%}
    {%- endif -%}

    {%- if posted -%}
      <div
        class="contact-form__success-message"
        role="status"
        aria-live="polite"
        tabindex="-1"
        autofocus
      >
        <h2 class="contact-form__success-heading">{{ 'blocks.contact_form.post_success_heading' | t }}</h2>
        <p>{{ 'blocks.contact_form.post_success' | t }}</p>
        <p class="contact-form__success-note">
          Our team replies Monday to Friday, 8am–4pm PT.
          <strong>No need to send it again</strong> — a second message won't reach us any faster.
        </p>
        <a class="contact-form__success-link" href="{{ routes.root_url }}">Continue shopping</a>
      </div>
    {%- endif -%}

    {%- if form.errors -%}
      <div
        class="contact-form__error-message"
        role="alert"
        tabindex="-1"
        autofocus
      >
        <p class="contact-form__error-heading">{{ 'blocks.contact_form.error_heading' | t }}</p>
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}

    {%- unless posted -%}
      <div class="contact-form__field">
        <label for="{{ form_id }}-name">
          {{- 'blocks.contact_form.name' | t -}}
          <span class="contact-form__required" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id="{{ form_id }}-name"
          class="contact-form__input"
          autocomplete="name"
          name="contact[name]"
          required
          value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
        >
      </div>

      <div class="contact-form__field">
        <label for="{{ form_id }}-email">
          {{- 'blocks.contact_form.email' | t -}}
          <span class="contact-form__required" aria-hidden="true">*</span>
        </label>
        <input
          type="email"
          id="{{ form_id }}-email"
          class="contact-form__input"
          autocomplete="email"
          name="contact[email]"
          spellcheck="false"
          autocapitalize="off"
          required
          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          aria-required="true"
          {% if form.errors contains 'email' %}
            aria-invalid="true"
          {% endif %}
        >
      </div>

      <div class="contact-form__field">
        <label for="{{ form_id }}-phone">
          {{- 'blocks.contact_form.phone' | t -}}
        </label>
        <input
          type="tel"
          id="{{ form_id }}-phone"
          class="contact-form__input"
          autocomplete="tel"
          name="contact[phone]"
          value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
        >
      </div>

      <div class="contact-form__field">
        <label for="{{ form_id }}-body">
          {{- 'blocks.contact_form.comment' | t -}}
          <span class="contact-form__required" aria-hidden="true">*</span>
        </label>
        <textarea
          rows="10"
          id="{{ form_id }}-body"
          class="contact-form__input contact-form__input--textarea"
          name="contact[body]"
          required
        >
          {{- form.body -}}
        </textarea>
      </div>

      <div class="contact-form__actions">
        {{ submit_button }}
      </div>
    {%- endunless -%}
  {%- endform -%}

  {%- if block.settings.business_hours != blank -%}
    <div class="contact-form__business-hours rte">
      {{ block.settings.business_hours }}
    </div>
  {%- endif -%}
</div>

<script>
  // Guard against double-submits. Re-running is harmless but pointless when
  // the block appears more than once on a page.
  if (!window.__contactFormSubmitGuard) {
    window.__contactFormSubmitGuard = true;

    document.addEventListener('submit', function (event) {
      var form = event.target;
      if (!form || !form.classList || !form.classList.contains('contact-form__form')) return;

      var btn = form.querySelector('button[type="submit"]');
      if (!btn || btn.dataset.submitting === 'true') return;

      btn.dataset.submitting = 'true';
      btn.dataset.originalLabel = btn.textContent.trim();
      btn.textContent = 'Sending…';

      // Deferred on purpose: disabling the button synchronously inside its own
      // submit handler cancels the submission in some browsers.
      setTimeout(function () {
        btn.disabled = true;
      }, 0);
    });

    // Browsers restore the cached page on Back. Without this the customer
    // returns to a dead button still reading "Sending…".
    window.addEventListener('pageshow', function (event) {
      if (!event.persisted) return;
      document.querySelectorAll('.contact-form__form button[type="submit"]').forEach(function (btn) {
        btn.disabled = false;
        btn.dataset.submitting = 'false';
        if (btn.dataset.originalLabel) btn.textContent = btn.dataset.originalLabel;
      });
    });
  }
</script>

{% stylesheet %}
  .contact-form__form {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    width: 100%;
    max-width: 600px;
    margin-inline: auto;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
    width: 100%;
  }

  .contact-form__field label {
    font-weight: var(--font-weight-medium, 500);
  }

  .contact-form__required {
    color: var(--color-primary-button-background, #dc0075);
    font-weight: 700;
  }

  .contact-form__input {
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--color-input-text);
    background-color: var(--color-input-background);
    padding: var(--padding-lg) var(--padding-xl);
    border-radius: var(--style-border-radius-inputs);
    border: var(--style-border-width-inputs) solid var(--color-input-border);
    -webkit-font-smoothing: antialiased;
  }

  .contact-form__input--textarea {
    resize: vertical;
    min-height: var(--input-textarea-min-height);
  }

  .contact-form__actions {
    display: flex;
    justify-content: flex-start;
  }

  .contact-form__actions .submit-button {
    width: 100%;
    text-transform: uppercase;
    font-weight: 700;
  }

  .contact-form__actions .submit-button[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  /* Success and error are deliberately hard-coded green/red rather than
     inheriting the brand palette — a confirmation rendered in brand pink
     reads as decoration, not as a state change. */
  .contact-form__success-message,
  .contact-form__error-message {
    width: 100%;
    max-width: 600px;
    margin-inline: auto;
    padding: var(--padding-xl, 1.25rem);
    border-radius: var(--style-border-radius-inputs, 8px);
    border-inline-start: 4px solid;
  }

  .contact-form__success-message {
    border-color: #1a7f37;
    background-color: #eef7f0;
    color: #14532d;
  }

  .contact-form__success-heading {
    margin: 0 0 0.5rem;
    font-size: var(--font-h4--size);
    line-height: var(--font-h4--line-height);
  }

  .contact-form__success-message p {
    margin: 0 0 0.5rem;
    line-height: 1.5;
  }

  .contact-form__success-note {
    font-size: 0.95em;
    opacity: 0.9;
  }

  .contact-form__success-link {
    display: inline-block;
    margin-block-start: 0.5rem;
    font-weight: 700;
    text-decoration: underline;
  }

  .contact-form__error-message {
    border-color: #c62828;
    background-color: #fdeeee;
    color: var(--color-error, #c62828);
  }

  .contact-form__error-heading {
    margin: 0 0 0.5rem;
    font-weight: 700;
  }

  .contact-form__business-hours {
    width: 100%;
    max-width: 600px;
    margin-block-start: var(--gap-lg);
    margin-inline: auto;
    text-align: center;
  }

  .contact-form__business-hours strong,
  .contact-form__business-hours b {
    color: var(--color-primary-button-background, #dc0075);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.contact_form",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "business_hours",
      "label": "Business hours",
      "default": "<h2><strong>Business Hours: Monday to Friday 8am to 4pm PT</strong></h2>"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.contact_form",
      "category": "t:categories.forms"
    }
  ]
}
{% endschema %}