  #footer-cookie-preferences.ot-sdk-show-settings.pb-privacy-choices-link {
    display: inline-flex;
    align-items: center;
    border: 0 !important;
    padding: 0 !important;
    padding-left: 32px !important;
    line-height: 25px !important;
    letter-spacing: 0 !important;
    font-weight: 400 !important;
