
{% if shop.policies.size > 0 %}
  {% if block.settings.layout == 'inline' %}
    <ul
      class="
        policy_list policy_list--inline list-unstyled
        custom-typography
        {% if block.settings.font_size != "" %}custom-font-size{% endif %}
      "
      style="{% render 'typography-style', preset: 'custom', settings: block.settings %}"
      {{ block.shopify_attributes }}
    >
      {%- for policy in shop.policies -%}
        {%- if policy != blank -%}
          {%- comment -%} pb: privacy policy points to the current /pages/privacy-policy (not the Shopify /policies default). {%- endcomment -%}
          {%- assign policy_url = policy.url -%}
          {%- assign policy_title_dc = policy.title | downcase -%}
          {%- if policy_title_dc contains 'privacy' -%}{%- assign policy_url = '/pages/privacy-policy' -%}{%- endif -%}
          <li>
            <a href="{{ policy_url }}" class="footer-utilities__text">
              {{- policy.title | escape -}}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
      {%- comment -%} Planet Beauty: OneTrust "Your Privacy Choices" as the last policy link (parity with live) {%- endcomment -%}
      <li class="pb-privacy-choices-item">
        {% render 'pb-privacy-choices-link' %}
      </li>
    </ul>
  {% else %}
    <anchored-popover-component
      data-hover-triggered="true"
    >
      <button
        class="policy-list-trigger button-unstyled"
        popovertarget="terms-policies-popover-{{ block.id }}"
        popovertargetaction="toggle"
        ref="trigger"
        style="{% render 'typography-style', preset: 'custom', settings: block.settings %}"
        {{ block.shopify_attributes }}
      >
        {{ 'content.terms_and_policies' | t }}
      </button>
      <div
        class="terms-policies-popover color-{{ settings.popover_color_scheme }}"
        id="terms-policies-popover-{{ block.id }}"
        popover="auto"
        ref="popover"
      >
        <ul
          class="
            policy_list list-unstyled
            custom-typography
            {% if block.settings.font_size != "" %}custom-font-size{% endif %}
          "
        >
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              {%- assign policy_url = policy.url -%}
              {%- assign policy_title_dc = policy.title | downcase -%}
              {%- if policy_title_dc contains 'privacy' -%}{%- assign policy_url = '/pages/privacy-policy' -%}{%- endif -%}
              <li>
                <a
                  href="{{ policy_url }}"
                  class="footer-utilities__text"
                >
                  {{- policy.title | escape -}}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
          {%- comment -%} Planet Beauty: OneTrust "Your Privacy Choices" as the last policy link (parity with live) {%- endcomment -%}
          <li class="pb-privacy-choices-item">
            {% render 'pb-privacy-choices-link' %}
          </li>
        </ul>
      </div>
    </anchored-popover-component>
  {% endif %}
{% endif %}

{% stylesheet %}
